{
  "name": "@exbotanical/prettier-config",
  "type": "module",
  "version": "2.0.1",
  "private": false,
  "description": "Zito's prettier config",
  "author": "Matthew Zito <exbotanical@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "prettier",
    "prettier-config"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    ".prettierignore",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --clean --dts",
    "docs": "typedoc && prettier --write docs/options.md",
    "docs:check": "npm run docs && git ls-files --error-unmatch docs/options.md && git diff --exit-code -- docs/options.md",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest --run",
    "test:dev": "vitest",
    "prepack": "npm run build",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && npm publish"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-solidity": "^2.4.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^3.0.2"
  },
  "peerDependenciesMeta": {
    "@prettier/plugin-xml": {
      "optional": true
    },
    "prettier-plugin-ini": {
      "optional": true
    },
    "prettier-plugin-nginx": {
      "optional": true
    },
    "prettier-plugin-properties": {
      "optional": true
    },
    "prettier-plugin-sh": {
      "optional": true
    },
    "prettier-plugin-solidity": {
      "optional": true
    },
    "prettier-plugin-sql": {
      "optional": true
    },
    "prettier-plugin-toml": {
      "optional": true
    }
  },
  "dependencies": {
    "local-pkg": "^1.1.1",
    "picomatch": "^4.0.7",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@exbotanical/eslint-config": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^22.13.8",
    "@types/picomatch": "^4.0.3",
    "bumpp": "^10.0.3",
    "eslint": "^9.39.5",
    "jiti": "^2.4.2",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.9",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-solidity": "^2.4.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^3.0.2",
    "simple-git-hooks": "^2.11.1",
    "tree-sitter-bash": "^0.25.1",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
